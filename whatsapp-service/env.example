# Server Configuration
PORT=3030

# WhatsApp Configuration
AUTH_PATH=./auth_info_baileys

# Logging
LOG_LEVEL=silent

# CORS
CORS_ORIGIN=*

# Message Queue Configuration (Anti-Spam Protection)
QUEUE_MSG_PER_MIN=10
QUEUE_MSG_PER_HOUR=100
QUEUE_MIN_DELAY=3000
QUEUE_MAX_DELAY=8000

# API Token for external access
API_TOKEN=your-secret-api-token-here